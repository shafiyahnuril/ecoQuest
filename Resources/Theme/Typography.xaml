<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Inter static files. SemiBold and ExtraBold ship as their own families (name ID 1), Regular/Bold share "Inter". -->
    <FontFamily x:Key="Font.Regular">pack://application:,,,/Resources/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.SemiBold">pack://application:,,,/Resources/Fonts/#Inter SemiBold, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Bold">pack://application:,,,/Resources/Fonts/#Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.ExtraBold">pack://application:,,,/Resources/Fonts/#Inter ExtraBold, Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.ExtraBold}" />
        <Setter Property="FontSize" Value="46" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
    </Style>
    <Style x:Key="Text.Hero" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="40" />
    </Style>
    <Style x:Key="Text.Header" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="32" />
    </Style>
    <Style x:Key="Text.AuthTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="31" /><!-- body.auth-mode .auth-card h1: clamp(25,2.4vw,34) at 1280 px = 30.7 -->
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="19" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="Text.Button" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>
    <Style x:Key="Text.Tiny" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>
    <Style x:Key="Text.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Primary}" />
    </Style>
    <Style x:Key="Text.Number" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.ExtraBold}" />
        <Setter Property="FontSize" Value="19" />
    </Style>
    <Style x:Key="Text.Impact" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.ExtraBold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
    </Style>
    <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="Text.Brand" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.ExtraBold}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Logo}" />
    </Style>
    <Style x:Key="Text.BodyRelaxed" TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
        <!-- .sub: line-height 1.55 x 14 px -->
        <Setter Property="LineHeight" Value="21.7" />
    </Style>
    <Style x:Key="Text.AuthLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>
    <Style x:Key="Text.Auth.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthPlaceholder}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14,0,0,0" />
    </Style>
    <Style x:Key="Text.Auth.Tagline" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthTagline}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Text.Auth.Welcome" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthWelcome}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style x:Key="Text.Auth.Kicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <!-- Sentence case (D-09); WPF has no letter-spacing. -->
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthKicker}" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>
    <Style x:Key="Text.AuthVisualHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <!-- .auth-copy h2: clamp(24,2.1vw,34) at 1280 px = 26.9; line-height 1.12 -->
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="27" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthHeading}" />
        <Setter Property="MaxWidth" Value="425" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Text.Auth.VisualBody" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <!-- .auth-copy p: clamp(12,1vw,14) = 12.8 at 1280 px; line-height 1.5 -->
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{StaticResource Text.AuthVisualBody}" />
        <Setter Property="MaxWidth" Value="395" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
</ResourceDictionary>

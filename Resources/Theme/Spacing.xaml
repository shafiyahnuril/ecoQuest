    <Thickness x:Key="Margin.RegisterAlt">0,8,0,0</Thickness><!-- .auth-register .auth-card .alt margin-top 8 -->
    <GridLength x:Key="Width.AuthColumnGap">16</GridLength>
    <!-- Register inputs: no vertical padding, the text is centred in the box. With 10 px padding a text box needs 39.3 px, so the 36 px
         of short windows (.auth-register .input) could not be reached. Same look at 44 px. Focus: 1 px less on every side (2 px border). -->
    <Thickness x:Key="Padding.InputRegister">13,0</Thickness>
    <Thickness x:Key="Padding.InputRegisterFocused">12,0</Thickness>
    <Thickness x:Key="Padding.InputRegisterReveal">13,0,44,0</Thickness>
    <Thickness x:Key="Padding.InputRegisterRevealFocused">12,0,43,0</Thickness><!-- .auth-register-fields column-gap -->

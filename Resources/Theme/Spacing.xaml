    <sys:Double x:Key="Clamp.RegisterInput.Min">36</sys:Double><!-- .auth-register .auth-card .input: clamp(36px,4.7vh,44px) -->
    <sys:Double x:Key="Clamp.RegisterInput.Max">44</sys:Double>
    <sys:Double x:Key="Clamp.RegisterInput.Vh">0.047</sys:Double>
    <sys:Double x:Key="Clamp.RegisterField.Min">9</sys:Double><!-- .auth-register .auth-card .field margin-bottom: clamp(9px,1.5vh,16px) -->
    <sys:Double x:Key="Clamp.RegisterField.Max">16</sys:Double>
    <sys:Double x:Key="Clamp.RegisterField.Vh">0.015</sys:Double>

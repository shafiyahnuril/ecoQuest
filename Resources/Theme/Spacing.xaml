    <Thickness x:Key="Margin.RegisterFieldShort">0,0,0,7</Thickness>
    <sys:Double x:Key="FontSize.RegisterTitleShort">23</sys:Double>
    <sys:Double x:Key="LineHeight.RegisterTitleShort">26</sys:Double>
    <sys:Double x:Key="LineHeight.AuthTitle">35</sys:Double>
    <Thickness x:Key="Margin.AuthTitle">0,0,0,8</Thickness>

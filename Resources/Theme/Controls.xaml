<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:conv="clr-namespace:ecoQuest.Converters"
                    xmlns:ctl="clr-namespace:EcoQuest.Controls"
                    mc:Ignorable="po">
    <!--
        Garden Light control styles (UI-UX-Flow-Frontend 2.4). Merged after Colors/Typography/Spacing and BEFORE Icons,
        so icon geometries are referenced with DynamicResource only.
    -->

    <conv:HalfHeightToCornerRadiusConverter x:Key="HalfHeightToCornerRadius" />
    <conv:RoundedClipConverter x:Key="RoundedClip" />

    <!-- Base window style: crisp edges at fractional DPI. Assign with Style="{StaticResource Window.Base}". -->
    <Style x:Key="Window.Base" TargetType="Window">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{StaticResource Bg.App}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
    </Style>

    <!-- Keyboard focus ring: 2 px Brand.Primary, 2 px offset (D-04). Applied to every focusable style below. -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-4" RadiusX="{Binding Source={StaticResource Radius.Button}, Path=TopLeft}"
                               RadiusY="{Binding Source={StaticResource Radius.Button}, Path=TopLeft}"
                               Stroke="{StaticResource Brand.Primary}" StrokeThickness="{StaticResource Stroke.Focus}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit styles only add the focus ring to controls that have no dedicated style. -->
    <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" /></Style>
    <Style TargetType="RadioButton"><Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" /></Style>
    <Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" /></Style>
    <Style TargetType="TabItem"><Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" /></Style>
    <!-- Scroll containers are not interaction targets: no WPF default dotted focus rectangle around the whole page area and not a Tab stop,
         but still Focusable so the keyboard (arrows, PageUp/PageDown, Home/End) scrolls them. Buttons, inputs and chips keep the Brand.Primary ring. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>
    <Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{StaticResource Brand.Primary}" /></Style>

    <!-- ===================== Buttons ===================== -->
    <ControlTemplate x:Key="Button.Template" TargetType="Button">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Button}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource Button.Template}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.OnPrimary}" />
        <Setter Property="Background" Value="{StaticResource Brand.Primary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Height.Button}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Button}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brand.PrimaryHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brand.PrimaryPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
        <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small variant keeps the secondary look; combine with Primary colours via a local Background if needed. -->
    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="{StaticResource Height.ButtonSmall}" />
        <Setter Property="Padding" Value="{StaticResource Padding.ButtonSmall}" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Input}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Mint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Text inputs ===================== -->
    <Style x:Key="TextBox.Default" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Bg.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Input}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Height.Input}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Input}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Primary}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            <Setter Property="Padding" Value="10,8" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource State.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PasswordBox.Default" TargetType="PasswordBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Bg.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Input}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Height.Input}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Input}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Input}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Primary}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            <Setter Property="Padding" Value="10,8" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource State.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inline field error text (12 px, below the input). -->
    <Style x:Key="Text.FieldError" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource State.Error}" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style x:Key="ComboBox.ToggleButton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path Data="{DynamicResource Icon.Chevron}" Width="14" Height="14" Margin="0,0,11,0" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Stretch="Uniform" Stroke="{StaticResource Brand.Forest}"
                              StrokeThickness="{StaticResource Stroke.Icon}" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><RotateTransform Angle="90" /></Path.RenderTransform>
                        </Path>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBoxItem.Default" TargetType="ComboBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="11,9" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Mint}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.ChipActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Default" TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Background" Value="{StaticResource Bg.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Input}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Height.Input}" />
        <Setter Property="IsEditable" Value="False" />
        <Setter Property="IsTextSearchEnabled" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Input}"
                                SnapsToDevicePixels="True" />
                        <ToggleButton Style="{StaticResource ComboBox.ToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="11,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border Margin="0,4,0,8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{StaticResource Bg.Surface}"
                                    BorderBrush="{StaticResource Line.Input}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Input}" Padding="4">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.Primary}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource State.Error}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Switch / Chip / Segmented ===================== -->
    <Style x:Key="ToggleButton.Switch" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Track" Width="{StaticResource Width.Switch}" Height="{StaticResource Height.Switch}"
                                CornerRadius="{StaticResource Radius.Switch}" Background="{StaticResource Bg.Track}" BorderBrush="{StaticResource Line.Input}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="2,0" HorizontalAlignment="Left"
                                     Fill="{StaticResource Line.Input}" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Brand.Primary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brand.Primary}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource Bg.Surface}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Chip.Template" TargetType="ToggleButton">
        <Border x:Name="Bd" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Line.Subtle}" BorderThickness="1"
                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfHeightToCornerRadius}}" Padding="{StaticResource Padding.Chip}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.NavHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.ChipActive}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line.ChipActive}" />
                <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="ToggleButton.Chip" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template" Value="{StaticResource Chip.Template}" />
    </Style>

    <Style x:Key="RadioButton.Segmented" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Line.Subtle}"
                            BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource HalfHeightToCornerRadius}}" Padding="{StaticResource Padding.Chip}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.NavHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.ChipActive}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Line.ChipActive}" />
                            <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Border.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <Style x:Key="Border.Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
        <Setter Property="CornerRadius">
            <Setter.Value>
                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" Converter="{StaticResource HalfHeightToCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="{StaticResource Padding.Pill}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!-- Text inside a pill (11 Bold, Brand.Forest). -->
    <Style x:Key="Text.Pill" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
    </Style>

    <Style x:Key="Border.Banner.Info" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Banner}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Banner}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Banner}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Banner}" />
    </Style>

    <Style x:Key="Border.Banner.Warning" TargetType="Border" BasedOn="{StaticResource Border.Banner.Info}">
        <Setter Property="Background" Value="{StaticResource State.WarningBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource State.WarningFg}" />
    </Style>

    <Style x:Key="Border.Banner.Error" TargetType="Border" BasedOn="{StaticResource Border.Banner.Info}">
        <Setter Property="Background" Value="{StaticResource State.ErrorBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource State.ErrorLine}" />
    </Style>

    <Style x:Key="Border.ActivityRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Activity}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Activity}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Line.ActivityHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Border.StickyFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Bg.Footer}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line.Footer}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Footer}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Footer}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.10" Color="{StaticResource Color.Shadow.Footer}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton: pulses 0.6 <-> 1 over 1.2 s; static when system animations are off (prefers-reduced-motion). -->
    <Style x:Key="Border.Skeleton" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Skeleton.Base}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}, Mode=OneWay}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SkeletonPulse">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1" Duration="0:0:0.6"
                                             AutoReverse="True" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SkeletonPulse" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Skeleton control: default corner radius = Radius.Input. -->
    <Style TargetType="ctl:Skeleton">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Input}" />
    </Style>

    <!-- Illustration of the empty states (eco_sprout_in_mossy_pot.png, shown at 85 px; decoded at 2x for 150% DPI). -->
    <BitmapImage x:Key="Image.EmptySprout" UriSource="pack://application:,,,/EcoQuest;component/Resources/Images/eco_sprout_in_mossy_pot.png" DecodePixelWidth="170"
                 CacheOption="OnLoad" po:Freeze="True" />

    <!-- Dashboard hero illustration (floating_garden_island_waterfall.png, shown at <= 540 DIP; decoded at 2x for 200% DPI). -->
    <BitmapImage x:Key="Image.HeroIsland" UriSource="pack://application:,,,/EcoQuest;component/Resources/Images/floating_garden_island_waterfall.png" DecodePixelWidth="1080"
                 CacheOption="OnLoad" po:Freeze="True" />

    <!-- StateHost (UIR-05): Idle/Loading -> LoadingContent, Error -> ErrorBanner, Loaded+IsEmpty -> EmptyContent, Loaded -> Content.
         Retry text uses DynamicResource because Strings.id.xaml is merged after this dictionary. -->
    <Style TargetType="ctl:StateHost">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ctl:StateHost">
                    <Grid>
                        <ContentPresenter x:Name="LoadingHost" Content="{TemplateBinding LoadingContent}" Visibility="Visible" />
                        <ctl:ErrorBanner x:Name="ErrorHost" Message="{TemplateBinding ErrorMessage}" RetryCommand="{TemplateBinding RetryCommand}"
                                         RetryText="{DynamicResource Common.Retry}" VerticalAlignment="Top" Visibility="Collapsed" />
                        <ContentPresenter x:Name="EmptyHost" Content="{TemplateBinding EmptyContent}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="ContentHost" Content="{TemplateBinding Content}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="State" Value="Error">
                            <Setter TargetName="LoadingHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ErrorHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="State" Value="Loaded">
                            <Setter TargetName="LoadingHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="State" Value="Loaded" />
                                <Condition Property="IsEmpty" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EmptyHost" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Track and fill are clipped to a capsule so both ends are identical at every value (0%, tiny values, 100%). -->
    <Style x:Key="ProgressBar.Mini" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Height.Progress}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.Clip>
                            <MultiBinding Converter="{StaticResource RoundedClip}">
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                            </MultiBinding>
                        </Grid.Clip>
                        <Border x:Name="PART_Track" Background="{StaticResource Bg.Track}" CornerRadius="{StaticResource Radius.Progress}">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Brand.Primary}">
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource RoundedClip}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                    </MultiBinding>
                                </Border.Clip>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tooltip ===================== -->
    <!-- Note: the 300 ms delay is a ToolTipService property of the host element, not of the ToolTip itself. -->
    <Style x:Key="ToolTip.Default" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Text.Primary}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Regular}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="{StaticResource MaxWidth.Tooltip}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Input}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lives here, not in Typography: it uses a Spacing token and Typography is merged before Spacing. -->
    <Style x:Key="Text.AuthDesc" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="MaxWidth" Value="{StaticResource MaxWidth.AuthDesc}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== Auth pages (Login/Register): body.auth-mode .auth-card .input / .auth-submit / .auth-error ===================== -->
    <Style x:Key="TextBox.Auth" TargetType="TextBox" BasedOn="{StaticResource TextBox.Default}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Bg.AuthInput}" />
        <Setter Property="MinHeight" Value="{StaticResource Height.InputAuth}" />
        <Setter Property="Padding" Value="{StaticResource Padding.InputAuth}" />
        <Style.Triggers>
            <!-- Keeps the text still when the 2 px focus border replaces the 1 px border (outer size is fixed by MinHeight). -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Padding.InputAuthFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PasswordBox.Auth" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Default}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Bg.AuthInput}" />
        <Setter Property="MinHeight" Value="{StaticResource Height.InputAuth}" />
        <Setter Property="Padding" Value="{StaticResource Padding.InputAuth}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Padding.InputAuthFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.AuthSubmit" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="MinHeight" Value="{StaticResource Height.ButtonAuth}" />
        <Setter Property="Margin" Value="{StaticResource Margin.AuthSubmit}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- .auth-card .alt .btn (ghost + small): width auto, min-height 30, padding 7x12, 12 px. -->
    <Style x:Key="Button.AuthLink" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinHeight" Value="{StaticResource MinHeight.AuthLink}" />
        <Setter Property="Padding" Value="{StaticResource Padding.AuthLink}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .auth-error: #FFF1EE / #EAC5C0 / #933B34, radius 9, padding 11. Collapsed while there is no message. -->
    <Style x:Key="Border.AuthError" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource State.ErrorBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource State.ErrorLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Button}" />
        <Setter Property="Padding" Value="{StaticResource Padding.AuthBanner}" />
        <Setter Property="Margin" Value="{StaticResource Margin.AuthBanner}" />
    </Style>

    <!-- Same look as Button.Icon, for a ToggleButton (Button.Icon targets Button only). -->
    <Style x:Key="ToggleButton.Icon" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Input}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Mint}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Reveal variants of the auth inputs: more right padding so text never runs under the toggle (D-16). -->
    <Style x:Key="TextBox.AuthReveal" TargetType="TextBox" BasedOn="{StaticResource TextBox.Auth}">
        <Setter Property="Padding" Value="{StaticResource Padding.InputAuthReveal}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Padding.InputAuthRevealFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PasswordBox.AuthReveal" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.Auth}">
        <Setter Property="Padding" Value="{StaticResource Padding.InputAuthReveal}" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Padding" Value="{StaticResource Padding.InputAuthRevealFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Default look of the shared password control: height of an auth input (44). Pages may override MinHeight. -->
    <Style TargetType="ctl:PasswordInput">
        <Setter Property="MinHeight" Value="{StaticResource Height.InputAuth}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" /><!-- the red border is drawn by the control itself (IsInvalid) -->
    </Style>

    <!-- .auth-card .field small: hint under a field. Becomes the error text when the Tag (bound to Validation.HasError of the input) is True.
         Same slot for both, so the layout does not jump. Announced to screen readers when the text changes. -->
    <Style x:Key="Text.AuthHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.AuthHint}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.AuthHint}" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Margin" Value="{StaticResource Margin.AuthHint}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource State.ErrorText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

<UserControl x:Class="EcoQuest.Controls.TimeRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             Focusable="False" Validation.ErrorTemplate="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="Button.ClearTime" TargetType="Button" BasedOn="{StaticResource Button.Icon}">
            <Setter Property="Margin" Value="{StaticResource Margin.TimeClear}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasValue, RelativeSource={RelativeSource AncestorType=ctl:TimeRangePicker}}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource Text.Tiny}" Text="{DynamicResource Time.Start}" Margin="{StaticResource Margin.TimeLabel}" />
            <TextBox x:Name="StartBox" Style="{StaticResource TextBox.Time}" AutomationProperties.Name="{DynamicResource Time.Start}"
                     ctl:InputState.IsInvalid="{Binding IsInvalid, RelativeSource={RelativeSource AncestorType=ctl:TimeRangePicker}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.TimeField}">
            <TextBlock Style="{StaticResource Text.Tiny}" Text="{DynamicResource Time.End}" Margin="{StaticResource Margin.TimeLabel}" />
            <TextBox x:Name="EndBox" Style="{StaticResource TextBox.Time}" AutomationProperties.Name="{DynamicResource Time.End}"
                     ctl:InputState.IsInvalid="{Binding IsInvalid, RelativeSource={RelativeSource AncestorType=ctl:TimeRangePicker}}" />
        </StackPanel>
        <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource Button.ClearTime}" Click="OnClearClick"
                AutomationProperties.Name="{DynamicResource Time.Clear}" ToolTip="{DynamicResource Time.Clear}">
            <ctl:IconView Data="{DynamicResource Icon.Close}" Foreground="{StaticResource Brand.Forest}"
                          Width="{StaticResource Size.IconSm}" Height="{StaticResource Size.IconSm}" />
        </Button>
    </Grid>
</UserControl>

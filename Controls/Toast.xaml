<UserControl x:Class="EcoQuest.Controls.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="po"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource Margin.Toast}"
             IsHitTestVisible="False" Focusable="False">
    <!-- DataContext = ToastViewModel. #toast: bottom 26 / right 27, Toast.Bg, white text, radius 11, padding 13x19,
         rises 12 px while fading in over 0.2 s. -->
    <UserControl.Resources>
        <DropShadowEffect x:Key="Effect.Toast" BlurRadius="40" ShadowDepth="16" Direction="270" Opacity="0.08"
                          Color="{StaticResource Color.Shadow.Toast}" po:Freeze="True" />
    </UserControl.Resources>
    <Border Background="{StaticResource Toast.Bg}" CornerRadius="{StaticResource Radius.Toast}"
            Padding="{StaticResource Padding.Toast}" Effect="{StaticResource Effect.Toast}" Opacity="0">
        <Border.RenderTransform>
            <TranslateTransform Y="{StaticResource Offset.Toast}" />
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="{StaticResource Offset.Toast}" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Style="{StaticResource Text.Base}" Text="{Binding Message}" Foreground="{StaticResource Text.OnPrimary}"
                   AutomationProperties.LiveSetting="Polite" />
    </Border>
</UserControl>

<UserControl x:Class="EcoQuest.Controls.WeatherSuggestionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             x:Name="Self" mc:Ignorable="d" IsTabStop="False" Focusable="False"
             d:DataContext="{d:DesignInstance Type=vm:WeatherSuggestionViewModel}">
    <!-- .forecast-card (INVENTORY-v7): DataContext = WeatherSuggestionViewModel. Skeleton while loading, then live data or the generic state.
         Compact = .forecast-compact (content min-height 75 instead of 96). Reference: design-reference/screens/08-summary.png. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Border.ForecastContent" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="{StaticResource Margin.ForecastContent}" />
            <Setter Property="Padding" Value="{StaticResource Padding.ForecastContent}" />
            <Setter Property="MinHeight" Value="{StaticResource MinHeight.ForecastContent}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType=ctl:WeatherSuggestionCard}}" Value="True">
                    <Setter Property="MinHeight" Value="{StaticResource MinHeight.ForecastContentCompact}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StackPanel.WhenLoaded" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StackPanel.WhenLoading" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StackPanel.CityLine" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CityLine}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Border.Card}" Background="{StaticResource Bg.Forecast}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.ForecastKicker}" Text="{DynamicResource Weather.Kicker}" />
                    <TextBlock Style="{StaticResource Text.ForecastTitle}" Margin="{StaticResource Margin.ForecastTitle}"
                               Text="{DynamicResource Weather.Title}" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel Orientation="Horizontal" Style="{StaticResource StackPanel.CityLine}">
                        <ctl:IconView Data="{DynamicResource Icon.History}" Foreground="{StaticResource Text.Secondary}"
                                      Width="{StaticResource Size.IconForecastSmall}" Height="{StaticResource Size.IconForecastSmall}"
                                      VerticalAlignment="Center" AutomationProperties.IsOffscreenBehavior="Offscreen" />
                        <TextBlock Style="{StaticResource Text.Small}" Margin="{StaticResource Margin.ForecastCityText}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding CityLine}" ToolTip="{Binding CityLine}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Width="{StaticResource Size.WeatherIcon}" Height="{StaticResource Size.WeatherIcon}" VerticalAlignment="Top"
                        Margin="{StaticResource Margin.ForecastIcon}" CornerRadius="{StaticResource Radius.WeatherIcon}"
                        Background="{StaticResource Weather.IconBg}" AutomationProperties.IsOffscreenBehavior="Offscreen">
                    <Grid>
                        <ctl:IconView Data="{DynamicResource Icon.Cloud}" Foreground="{StaticResource Weather.IconFg}"
                                      Width="{StaticResource Size.IconWeatherCloud}" Height="{StaticResource Size.IconWeatherCloud}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ctl:IconView Data="{DynamicResource Icon.Sun}" Foreground="{StaticResource Weather.IconFg}"
                                      Width="{StaticResource Size.IconWeatherSun}" Height="{StaticResource Size.IconWeatherSun}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{StaticResource Margin.IconWeatherSun}" />
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Style="{StaticResource StackPanel.WhenLoading}" AutomationProperties.Name="{Binding LoadingText}">
                <Border Style="{StaticResource Border.ForecastContent}">
                    <Border Style="{StaticResource Border.Skeleton}" Width="{StaticResource Width.SkeletonLine}"
                            Height="{StaticResource Height.SkeletonLine}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource Border.Skeleton}" Height="{StaticResource Height.SkeletonAdvice}"
                        CornerRadius="{StaticResource Radius.Banner}" Margin="{StaticResource Margin.SkeletonAdvice}" />
            </StackPanel>

            <StackPanel Style="{StaticResource StackPanel.WhenLoaded}">
                <Border Style="{StaticResource Border.ForecastContent}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ctl:IconView Data="{DynamicResource Icon.Cloud}" Foreground="{StaticResource Brand.Primary}"
                                      Width="{StaticResource Size.IconForecast}" Height="{StaticResource Size.IconForecast}"
                                      VerticalAlignment="Center" AutomationProperties.IsOffscreenBehavior="Offscreen" />
                        <StackPanel Margin="{StaticResource Margin.ForecastContentText}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.ForecastContentTitle}" Text="{Binding ContentTitle}" />
                            <TextBlock Style="{StaticResource Text.ForecastContentSub}" Margin="{StaticResource Margin.ForecastContentSub}"
                                       TextWrapping="Wrap" Text="{Binding ContentSubtitle}"
                                       Visibility="{Binding HasContentSubtitle, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Bg.Banner}" CornerRadius="{StaticResource Radius.Banner}" Padding="{StaticResource Padding.ForecastAdvice}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="{StaticResource Size.ForecastAdviceIcon}" Height="{StaticResource Size.ForecastAdviceIcon}" VerticalAlignment="Top"
                                Background="{StaticResource Bg.Surface}" CornerRadius="{StaticResource Radius.ForecastAdviceIcon}"
                                AutomationProperties.IsOffscreenBehavior="Offscreen">
                            <ctl:IconView Data="{DynamicResource Icon.Leaf}" Foreground="{StaticResource Brand.Forest}"
                                          Width="{StaticResource Size.IconSm}" Height="{StaticResource Size.IconSm}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="{StaticResource Margin.ForecastAdviceText}">
                            <TextBlock Style="{StaticResource Text.ForecastAdviceHeading}" Text="{Binding AdviceHeading}" />
                            <TextBlock Style="{StaticResource Text.ForecastAdviceBody}" Margin="{StaticResource Margin.ForecastAdviceBody}"
                                       TextWrapping="Wrap" Text="{Binding AdviceText}" />
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasImpact, Converter={StaticResource BoolToVisibility}}">
                                <ctl:IconView Data="{DynamicResource Icon.Leaf}" Foreground="{StaticResource Fg.ForecastImpact}"
                                              Width="{StaticResource Size.IconForecastSmall}" Height="{StaticResource Size.IconForecastSmall}"
                                              VerticalAlignment="Center" AutomationProperties.IsOffscreenBehavior="Offscreen" />
                                <TextBlock Style="{StaticResource Text.ForecastImpact}" Margin="{StaticResource Margin.ForecastFooterText}"
                                           VerticalAlignment="Center" Text="{Binding ImpactText}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,1,0,0" Margin="{StaticResource Margin.ForecastFooter}"
                        Padding="{StaticResource Padding.ForecastFooter}">
                    <StackPanel Orientation="Horizontal">
                        <ctl:IconView Data="{DynamicResource Icon.Info}" Foreground="{StaticResource Text.Secondary}"
                                      Width="{StaticResource Size.IconForecastSmall}" Height="{StaticResource Size.IconForecastSmall}"
                                      VerticalAlignment="Center" AutomationProperties.IsOffscreenBehavior="Offscreen" />
                        <TextBlock Style="{StaticResource Text.ForecastFooter}" Margin="{StaticResource Margin.ForecastFooterText}"
                                   VerticalAlignment="Center" Text="{Binding FooterText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

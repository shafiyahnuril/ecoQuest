<UserControl x:Class="EcoQuest.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
    <!-- Busy layer: place it as the last child of a Grid that also holds the content, spanning the same cell. While IsActive it covers the
         content with a translucent scrim (Overlay.Busy) that swallows mouse input, and shows a spinner with optional text. The spinner only
         turns when SystemParameters.ClientAreaAnimation is true; otherwise it stays as a static arc. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, ElementName=Self}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <Grid Background="{StaticResource Overlay.Busy}" IsHitTestVisible="True">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="{StaticResource Size.Spinner}" Height="{StaticResource Size.Spinner}" HorizontalAlignment="Center"
                  AutomationProperties.IsOffscreenBehavior="Offscreen">
                <Ellipse Stroke="{StaticResource Bg.Track}" StrokeThickness="{StaticResource Stroke.Spinner}" />
                <Ellipse x:Name="Arc" Stroke="{StaticResource Brand.Primary}" StrokeThickness="{StaticResource Stroke.Spinner}"
                         StrokeDashArray="6.5 19.5" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="0" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsActive, ElementName=Self}" Value="True" />
                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}, Mode=OneWay}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <MultiDataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="SpinnerTurn">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </MultiDataTrigger.EnterActions>
                                    <MultiDataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="SpinnerTurn" />
                                    </MultiDataTrigger.ExitActions>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="BusyText" Text="{Binding Text, ElementName=Self}" TextAlignment="Center"
                       Margin="{StaticResource Margin.SpinnerText}" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodySecondary}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="EcoQuest.Controls.PasswordInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             Focusable="False">
    <!-- Shared password column (Login, Register, Profile). PasswordBox ("•") and TextBox swap places; both bind to the Password property.
         Toggle: 34x34 icon button inside the column, right, vertically centred, margin right 5. Not in the HTML prototype (D-16). -->
    <UserControl.Resources>
        <Style x:Key="Box.HiddenMode" TargetType="PasswordBox" BasedOn="{StaticResource PasswordBox.AuthReveal}">
            <Setter Property="MinHeight" Value="{Binding MinHeight, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRevealed, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Box.ShownMode" TargetType="TextBox" BasedOn="{StaticResource TextBox.AuthReveal}">
            <Setter Property="MinHeight" Value="{Binding MinHeight, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRevealed, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.PlaceholderOverlay" TargetType="TextBlock" BasedOn="{StaticResource Text.Auth.Placeholder}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Password, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Password, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Hidden state shows the struck-through eye; the name/tooltip always name the ACTION. -->
        <Style x:Key="ToggleButton.Reveal" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButton.Icon}">
            <Setter Property="ToolTip" Value="{DynamicResource Login.PasswordShow}" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Login.PasswordShow}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="ToolTip" Value="{DynamicResource Login.PasswordHide}" />
                    <Setter Property="AutomationProperties.Name" Value="{DynamicResource Login.PasswordHide}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconView.Reveal" TargetType="ctl:IconView">
            <Setter Property="Width" Value="{StaticResource Size.IconMd}" />
            <Setter Property="Height" Value="{StaticResource Size.IconMd}" />
            <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
            <Setter Property="Data" Value="{DynamicResource Icon.EyeOff}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Data" Value="{DynamicResource Icon.Eye}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <PasswordBox x:Name="HiddenBox" Style="{StaticResource Box.HiddenMode}" PasswordChar="•"
                     ctl:PasswordBoxHelper.BoundPassword="{Binding Password, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" />
        <TextBox x:Name="ShownBox" Style="{StaticResource Box.ShownMode}"
                 Text="{Binding Password, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" />
        <TextBlock Style="{StaticResource Text.PlaceholderOverlay}"
                   Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}}" />
        <ToggleButton x:Name="RevealToggle" Style="{StaticResource ToggleButton.Reveal}"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource Margin.PasswordToggle}"
                      IsChecked="{Binding IsRevealed, RelativeSource={RelativeSource AncestorType=ctl:PasswordInput}, Mode=TwoWay}">
            <ctl:IconView Style="{StaticResource IconView.Reveal}" />
        </ToggleButton>
    </Grid>
</UserControl>

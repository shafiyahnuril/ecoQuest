<UserControl x:Class="EcoQuest.Controls.ErrorBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
    <!-- Error state: shows Message exactly as given plus a retry button bound to RetryCommand (text from RetryText, passed from
         Strings.id.xaml Common.Retry). Layout follows .banner (flex, gap 14, space-between). Announced assertively when it appears. -->
    <Border Style="{StaticResource Border.Banner.Error}" AutomationProperties.LiveSetting="Assertive">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Style="{StaticResource Icon.Path}" Data="{DynamicResource Icon.Alert}" Stroke="{StaticResource State.ErrorText}"
                  Width="{StaticResource Size.IconSm}" Height="{StaticResource Size.IconSm}" Margin="{StaticResource Margin.BannerIcon}"
                  VerticalAlignment="Center" AutomationProperties.IsOffscreenBehavior="Offscreen" />
            <TextBlock x:Name="MessageText" Grid.Column="1" Style="{StaticResource Text.Body}" Foreground="{StaticResource State.ErrorText}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Message, ElementName=Self}" />
            <Button x:Name="RetryButton" Grid.Column="2" Style="{StaticResource Button.Small}" Margin="{StaticResource Margin.BannerAction}"
                    VerticalAlignment="Center" Content="{Binding RetryText, ElementName=Self}"
                    Command="{Binding RetryCommand, ElementName=Self}" />
        </Grid>
    </Border>
</UserControl>

<Application x:Class="ecoQuest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ecoQuest"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dependency order matters: Colors -> Typography -> Spacing -> Controls -> Icons -> Strings -->
                <ResourceDictionary Source="Resources/Theme/Colors.xaml" />
                <ResourceDictionary Source="Resources/Theme/Typography.xaml" />
                <ResourceDictionary Source="Resources/Theme/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.xaml" />
                <ResourceDictionary Source="Resources/Icons/Icons.xaml" />
                <ResourceDictionary Source="Resources/Strings.id.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

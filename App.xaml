<Application x:Class="ecoQuest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ecoQuest"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:v="clr-namespace:EcoQuest.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Dependency order matters: Colors -> Typography -> Spacing -> Controls -> Icons -> Strings -->
                <ResourceDictionary Source="Resources/Theme/Colors.xaml" />
                <ResourceDictionary Source="Resources/Theme/Typography.xaml" />
                <ResourceDictionary Source="Resources/Theme/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Theme/Controls.xaml" />
                <ResourceDictionary Source="Resources/Icons/Icons.xaml" />
                <ResourceDictionary Source="Resources/Strings.id.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel -> View (UIR-02). All screens S-01..S-11 are registered once here (FE-02). -->
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterViewModel}"><v:RegisterView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OnboardingViewModel}"><v:OnboardingView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EveningReviewViewModel}"><v:EveningReviewView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AchievementsViewModel}"><v:AchievementsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LeaderboardViewModel}"><v:LeaderboardView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><v:ProfileView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConnectionErrorViewModel}"><v:ConnectionErrorView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

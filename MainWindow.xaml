<Window x:Class="ecoQuest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EcoQuest.ViewModels"
        xmlns:ctl="clr-namespace:EcoQuest.Controls"
        xmlns:conv="clr-namespace:EcoQuest.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Style="{StaticResource Window.Base}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Title="{DynamicResource Brand.Name}" Height="800" Width="1280"
        MinWidth="{StaticResource Window.MinWidth}" MinHeight="{StaticResource Window.MinHeight}"
        WindowStartupLocation="CenterScreen">
    <!-- DataContext = ShellViewModel (set by App.OnStartup). Shell of UI-UX-Flow-Frontend 3:
         auth area (no sidebar) OR main area (sidebar | page). Prototype: .app-window .sidebar .nav .account .logout .content. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResourceKeyConverter x:Key="ResourceKey" />
        <conv:CompactWidthConverter x:Key="IsCompactWidth" />

        <!-- ===== Sidebar navigation item (.nav button): hover = Bg.NavHover, active = Bg.NavActive (wins over hover, as in the CSS) ===== -->
        <Style x:Key="Button.NavItem" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="{StaticResource Height.NavItem}" />
            <Setter Property="Padding" Value="{StaticResource Padding.NavItem}" />
            <Setter Property="Margin" Value="{StaticResource Margin.NavItem}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Button}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Bg.NavHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Bg.NavActive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconView.NavItem" TargetType="ctl:IconView">
            <Setter Property="Width" Value="{StaticResource Size.NavIcon}" />
            <Setter Property="Height" Value="{StaticResource Size.NavIcon}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Text.Nav}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brand.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Text.NavActive}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Text.NavLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text.Nav}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brand.Forest}" />
                    <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NavItemTemplate" DataType="{x:Type vm:NavItemViewModel}">
            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Menu}"
                    AutomationProperties.Name="{Binding LabelKey, Converter={StaticResource ResourceKey}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Button.NavItem}">
                        <Style.Triggers>
                            <!-- D-05: the amber dot has 1.95:1 contrast, so it is also announced and explained in a tooltip. -->
                            <DataTrigger Binding="{Binding IsPendingIndicatorVisible}" Value="True">
                                <Setter Property="AutomationProperties.HelpText" Value="{DynamicResource Nav.PendingHint}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:IconView Style="{StaticResource IconView.NavItem}"
                                  Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.NavLabel}" Margin="{StaticResource Margin.NavLabel}"
                               Text="{Binding LabelKey, Converter={StaticResource ResourceKey}}" />
                    <Ellipse Grid.Column="2" Width="{StaticResource Size.PendingDot}" Height="{StaticResource Size.PendingDot}"
                             Fill="{StaticResource Accent.Amber}" VerticalAlignment="Center"
                             Visibility="{Binding IsPendingIndicatorVisible, Converter={StaticResource BoolToVisibility}}"
                             AutomationProperties.HelpText="{DynamicResource Nav.PendingHint}"
                             ToolTipService.InitialShowDelay="300">
                        <Ellipse.ToolTip>
                            <ToolTip Style="{StaticResource ToolTip.Default}" Content="{DynamicResource Nav.PendingHint}" />
                        </Ellipse.ToolTip>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ===== "Keluar" (.logout): text button, muted, icon 15 ===== -->
        <Style x:Key="Button.Logout" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
            <Setter Property="Padding" Value="{StaticResource Padding.Logout}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Button}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== @media(max-width:1160px): sidebar 200 and content padding 24 (UI-UX-Flow-Frontend 2.3) ===== -->
        <Style x:Key="Border.Sidebar" TargetType="Border">
            <Setter Property="Width" Value="{StaticResource Width.Sidebar}" />
            <Setter Property="Background" Value="{StaticResource Bg.Sidebar}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line.Subtle}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="{StaticResource Padding.Sidebar}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactWidth}}" Value="True">
                    <Setter Property="Width" Value="{StaticResource Width.SidebarCompact}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Border.Content" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Padding.Page}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IsCompactWidth}}" Value="True">
                    <Setter Property="Padding" Value="{StaticResource Padding.PageCompact}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.Dashboard}" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.EveningReview}" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.History}" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.Achievements}" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.Leaderboard}" />
        <KeyBinding Gesture="Ctrl+6" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainMenu.Profile}" />
        <!-- DEBUG-only: opens the FE-01 theme preview in a separate window; the command does nothing in Release. -->
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding OpenThemePreviewCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource Bg.App}">
        <!-- Auth area: Login, Register, Onboarding. No sidebar. -->
        <ContentControl Content="{Binding AuthViewModel}" IsTabStop="False" />

        <!-- Main area: sidebar | page. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAuthenticated}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Border.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.SidebarBrand}">
                        <ctl:IconView Data="{DynamicResource Icon.Leaf}" Foreground="{StaticResource Brand.Primary}"
                                      Width="{StaticResource Size.BrandIcon}" Height="{StaticResource Size.BrandIcon}" />
                        <TextBlock Style="{StaticResource Text.Brand}" Text="{DynamicResource Brand.Name}"
                                   Margin="{StaticResource Margin.BrandText}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MenuItems}" ItemTemplate="{StaticResource NavItemTemplate}"
                                  IsTabStop="False" AutomationProperties.Name="{DynamicResource Nav.Landmark}" />

                    <!-- Account block (.account). TODO(after Core/Contracts): avatar initial, user name and city come from the
                         session (ShellViewModel.UserName / City / AvatarImagePath, UIR-24/25). Structure only for now. -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,1,0,0"
                            Padding="{StaticResource Padding.Account}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="{StaticResource Size.AvatarSidebar}" Height="{StaticResource Size.AvatarSidebar}">
                                <Ellipse Fill="{StaticResource Bg.Avatar}" />
                                <TextBlock Style="{StaticResource Text.Number}" Foreground="{StaticResource Brand.Forest}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Margin="{StaticResource Margin.AccountText}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Number}" FontSize="14" />
                                <TextBlock Style="{StaticResource Text.Small}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="3" Style="{StaticResource Button.Logout}" Command="{Binding LogoutCommand}"
                            AutomationProperties.Name="{DynamicResource Nav.Logout}">
                        <StackPanel Orientation="Horizontal">
                            <ctl:IconView Data="{DynamicResource Icon.Logout}" Foreground="{StaticResource Text.Secondary}"
                                          Width="{StaticResource Size.LogoutIcon}" Height="{StaticResource Size.LogoutIcon}" />
                            <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{DynamicResource Nav.Logout}"
                                       Margin="{StaticResource Margin.LogoutLabel}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- .content: Bg.App + soft green glow top-right; the page scrolls, the sidebar stays. -->
            <Grid Grid.Column="1">
                <Border Background="{StaticResource Bg.ContentGlow}" IsHitTestVisible="False" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              ctl:ScrollViewerHelper.ScrollToTopOnChange="{Binding MainViewModel}">
                    <Border Style="{StaticResource Border.Content}">
                        <ContentControl Content="{Binding MainViewModel}" IsTabStop="False" />
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <ctl:Toast DataContext="{Binding Toast}" />
    </Grid>
</Window>

<UserControl x:Class="EcoQuest.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:items="clr-namespace:EcoQuest.ViewModels.Items"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             mc:Ignorable="d" IsTabStop="False" FocusVisualStyle="{x:Null}"
             d:DataContext="{d:DesignInstance Type=vm:LeaderboardViewModel}">
    <!-- S-09 Leaderboard. Reference: design-reference/screens/11-leaderboard.png, INVENTORY-v7 .table / tr.selected.
         Deltas (UI-UX-Flow-Frontend 4.0): single card without the "Fitur opsional" pill and sample-data notes; full intro text;
         own row = Bg.Mint + 3 px Brand.Primary left bar plus a "Kamu" label (not colour alone); "..." row for an own rank outside the list; no avatars (FR-7.3). -->
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type items:LeaderboardRowViewModel}">
            <Border x:Name="Row" BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,0,0,1"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Width.LeaderboardAccent}" />
                        <ColumnDefinition Width="{StaticResource Width.LeaderboardRank}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource Width.LeaderboardCo2}" />
                        <ColumnDefinition Width="{StaticResource Width.LeaderboardLevel}" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Accent" Background="Transparent" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.TableCell}" Margin="{StaticResource Padding.LeaderboardRow}" Text="{Binding RankText}" />
                    <DockPanel Grid.Column="2" Margin="{StaticResource Padding.LeaderboardRow}" LastChildFill="True">
                        <Border x:Name="YouPill" DockPanel.Dock="Right" Style="{StaticResource Border.Pill}" Margin="{StaticResource Margin.LeaderboardYou}"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Text.Pill}" Text="{DynamicResource Leaderboard.You}" TextWrapping="NoWrap" />
                        </Border>
                        <TextBlock x:Name="Name" Style="{StaticResource Text.TableCell}" Text="{Binding UserName}" ToolTip="{Binding UserName}" />
                    </DockPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.TableCell}" Margin="{StaticResource Padding.LeaderboardRow}" Text="{Binding Co2Text}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource Text.TableCell}" Margin="{StaticResource Padding.LeaderboardRow}" Text="{Binding LevelText}"
                               ToolTip="{Binding LevelText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrentUser}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Bg.Mint}" />
                    <Setter TargetName="Accent" Property="Background" Value="{StaticResource Brand.Primary}" />
                    <Setter TargetName="YouPill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Name" Property="FontFamily" Value="{StaticResource Font.SemiBold}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type items:LeaderboardGapRowViewModel}">
            <Border BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,0,0,1" Padding="{StaticResource Padding.LeaderboardRow}"
                    AutomationProperties.IsOffscreenBehavior="Offscreen">
                <TextBlock Style="{StaticResource Text.TableCell}" HorizontalAlignment="Center" Text="{DynamicResource Leaderboard.Gap}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="{StaticResource Margin.PageHead}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Text.Header}" TextWrapping="NoWrap" Text="{DynamicResource Nav.Leaderboard}"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Margin="{StaticResource Margin.PageHeadDate}" TextWrapping="NoWrap"
                       VerticalAlignment="Top" Text="{Binding TodayText}" />
        </Grid>

        <ctl:StateHost State="{Binding State}" IsEmpty="{Binding IsEmpty}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
            <ctl:StateHost.LoadingContent>
                <Border Style="{StaticResource Border.Card}">
                    <StackPanel>
                        <ctl:Skeleton Height="{StaticResource Height.SkeletonLeaderboardRow}" Margin="{StaticResource Margin.LeaderboardIntro}" />
                        <ctl:Skeleton Height="{StaticResource Height.SkeletonLeaderboardRow}" Margin="{StaticResource Margin.LeaderboardIntro}" />
                        <ctl:Skeleton Height="{StaticResource Height.SkeletonLeaderboardRow}" Margin="{StaticResource Margin.LeaderboardIntro}" />
                        <ctl:Skeleton Height="{StaticResource Height.SkeletonLeaderboardRow}" />
                    </StackPanel>
                </Border>
            </ctl:StateHost.LoadingContent>

            <ctl:StateHost.EmptyContent>
                <Border Style="{StaticResource Border.Card}" Padding="0">
                    <ctl:EmptyState ImageSource="{StaticResource Image.EmptySprout}" ImageWidth="160" Title="{DynamicResource Leaderboard.Empty}" />
                </Border>
            </ctl:StateHost.EmptyContent>

            <ctl:StateHost.Content>
                <Border Style="{StaticResource Border.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Small}" Margin="{StaticResource Margin.LeaderboardIntro}" TextWrapping="Wrap"
                                   Text="{DynamicResource Leaderboard.Intro}" />
                        <Border BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,0,0,1" AutomationProperties.IsOffscreenBehavior="Offscreen">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Width.LeaderboardAccent}" />
                                    <ColumnDefinition Width="{StaticResource Width.LeaderboardRank}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource Width.LeaderboardCo2}" />
                                    <ColumnDefinition Width="{StaticResource Width.LeaderboardLevel}" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Style="{StaticResource Text.TableHead}" Margin="{StaticResource Padding.LeaderboardRow}"
                                           Text="{DynamicResource Leaderboard.Col.Rank}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Text.TableHead}" Margin="{StaticResource Padding.LeaderboardRow}"
                                           Text="{DynamicResource Leaderboard.Col.User}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Text.TableHead}" Margin="{StaticResource Padding.LeaderboardRow}"
                                           Text="{DynamicResource Leaderboard.Col.Co2}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource Text.TableHead}" Margin="{StaticResource Padding.LeaderboardRow}"
                                           Text="{DynamicResource Leaderboard.Col.Level}" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" Focusable="False" FocusVisualStyle="{x:Null}"
                                      AutomationProperties.Name="{DynamicResource Leaderboard.TableName}" />
                    </StackPanel>
                </Border>
            </ctl:StateHost.Content>
        </ctl:StateHost>
    </StackPanel>
</UserControl>

            <TextBlock Style="{StaticResource Text.Title}" Text="State umum: skeleton, empty, error, busy" Margin="0,16,0,10" />
            <StackPanel>
                <StackPanel.DataContext>
                    <local:StatePreviewViewModel />
                </StackPanel.DataContext>
                <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Statis: tiap kartu = satu StateHost dengan State tetap (Loading, Loaded+kosong, Error, Loaded)." />
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border Style="{StaticResource Border.Card}" Margin="0,0,8,8">
                        <ctl:StateHost State="Loading">
                            <ctl:StateHost.LoadingContent>
                                <StackPanel>
                                    <ctl:Skeleton Height="16" Margin="0,0,0,8" />
                                    <ctl:Skeleton Height="16" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                    <ctl:Skeleton Height="64" CornerRadius="14" />
                                </StackPanel>
                            </ctl:StateHost.LoadingContent>
                        </ctl:StateHost>
                    </Border>
                    <Border Style="{StaticResource Border.Card}" Margin="8,0,0,8">
                        <ctl:StateHost State="Loaded" IsEmpty="True">
                            <ctl:StateHost.EmptyContent>
                                <ctl:EmptyState ImageSource="{StaticResource Image.EmptySprout}" Text="{StaticResource Dashboard.ChartEmpty}" />
                            </ctl:StateHost.EmptyContent>
                        </ctl:StateHost>
                    </Border>
                    <Border Style="{StaticResource Border.Card}" Margin="0,0,8,8">
                        <ctl:StateHost State="Error" ErrorMessage="{StaticResource Offline.Title}" />
                    </Border>
                    <Border Style="{StaticResource Border.Card}" Margin="8,0,0,8">
                        <ctl:StateHost State="Loaded">
                            <ctl:StateHost.Content>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Konten normal tampil saat Loaded dan tidak kosong." />
                            </ctl:StateHost.Content>
                        </ctl:StateHost>
                    </Border>
                </UniformGrid>

                <TextBlock Style="{StaticResource Text.Small}" Margin="0,0,0,6" TextWrapping="Wrap"
                           Text="Interaktif: ganti state dengan tombol; Coba lagi menaikkan penghitung dan kembali ke normal. Overlay busy memblokir klik pada kartu." />
                <WrapPanel Margin="0,0,0,8">
                    <Button Style="{StaticResource Button.Small}" Content="Memuat" Command="{Binding ShowLoadingCommand}" Margin="0,0,7,7" />
                    <Button Style="{StaticResource Button.Small}" Content="Kosong" Command="{Binding ShowEmptyCommand}" Margin="0,0,7,7" />
                    <Button Style="{StaticResource Button.Small}" Content="Error" Command="{Binding ShowErrorCommand}" Margin="0,0,7,7" />
                    <Button Style="{StaticResource Button.Small}" Content="Normal" Command="{Binding ShowNormalCommand}" Margin="0,0,7,7" />
                    <Button Style="{StaticResource Button.Small}" Content="Busy hidup/mati" Command="{Binding ToggleBusyCommand}" Margin="0,0,7,7" />
                    <TextBlock Style="{StaticResource Text.Small}" VerticalAlignment="Center" Text="{Binding RetryCount, StringFormat='Coba lagi ditekan: {0}'}" />
                </WrapPanel>
                <Grid MaxWidth="560" HorizontalAlignment="Left">
                    <Border Style="{StaticResource Border.Card}" MinHeight="200">
                        <ctl:StateHost State="{Binding State}" IsEmpty="{Binding IsEmpty}" ErrorMessage="{Binding ErrorMessage}"
                                       RetryCommand="{Binding RetryCommand}">
                            <ctl:StateHost.LoadingContent>
                                <StackPanel>
                                    <ctl:Skeleton Height="16" Margin="0,0,0,8" />
                                    <ctl:Skeleton Height="16" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                    <ctl:Skeleton Height="64" CornerRadius="14" />
                                </StackPanel>
                            </ctl:StateHost.LoadingContent>
                            <ctl:StateHost.EmptyContent>
                                <ctl:EmptyState ImageSource="{StaticResource Image.EmptySprout}" Text="{StaticResource History.Empty}"
                                                ActionText="{StaticResource History.EmptyCta}" ActionCommand="{Binding ShowNormalCommand}" />
                            </ctl:StateHost.EmptyContent>
                            <ctl:StateHost.Content>
                                <TextBlock Style="{StaticResource Text.Body}" Text="Konten normal." />
                            </ctl:StateHost.Content>
                        </ctl:StateHost>
                    </Border>
                    <ctl:BusyOverlay IsActive="{Binding IsBusy}" Text="Memproses…" />
                </Grid>
            </StackPanel>


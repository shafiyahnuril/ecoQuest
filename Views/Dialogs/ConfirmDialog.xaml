<Window x:Class="EcoQuest.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:EcoQuest.Controls"
        mc:Ignorable="po"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.Regular}"
        ctl:DialogHelper.DialogResult="{Binding Result}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        AutomationProperties.Name="{Binding Title}">
    <!-- DataContext = ConfirmDialogViewModel. Covers the owner's client area (DialogService): .modal-backdrop + .modal.
         Esc and a click outside the card cancel; the first button (Batal) gets the initial focus (UI-UX-Flow-Frontend 2.8). -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DropShadowEffect x:Key="Effect.Dialog" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.34"
                          Color="{StaticResource Color.Shadow.Dialog}" po:Freeze="True" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Grid>
        <!-- Sibling (not parent) of the card, so clicks on the card never reach this binding. -->
        <Border Background="{StaticResource Overlay.Backdrop}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CancelCommand}" />
            </Border.InputBindings>
        </Border>

        <Border Width="{StaticResource Width.Dialog}" Margin="{StaticResource Margin.Backdrop}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Bg.Surface}" CornerRadius="{StaticResource Radius.Dialog}"
                Padding="{StaticResource Padding.Dialog}" Effect="{StaticResource Effect.Dialog}">
            <StackPanel>
                <Grid Width="{StaticResource Size.BubbleModal}" Height="{StaticResource Size.BubbleModal}"
                      HorizontalAlignment="Left" Margin="{StaticResource Margin.DialogIcon}">
                    <Ellipse Fill="{StaticResource Bubble.Modal.Bg}" />
                    <ctl:IconView Data="{DynamicResource Icon.Info}" Foreground="{StaticResource Bubble.Default.Fg}"
                                  Width="{StaticResource Size.IconModal}" Height="{StaticResource Size.IconModal}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}"
                           Margin="{StaticResource Margin.DialogTitle}" />
                <TextBlock Style="{StaticResource Text.BodyRelaxed}" Text="{Binding Message}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Margin.DialogActions}">
                    <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}" Content="{Binding CancelText}"
                            Command="{Binding CancelCommand}" MinWidth="{StaticResource MinWidth.DialogButton}"
                            Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" Content="{Binding ConfirmText}"
                            Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="{StaticResource MinWidth.DialogButton}"
                            Margin="{StaticResource Margin.DialogActionGap}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

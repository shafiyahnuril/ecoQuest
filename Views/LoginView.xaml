<UserControl x:Class="EcoQuest.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             xmlns:conv="clr-namespace:EcoQuest.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
             Background="{StaticResource Bg.AuthPage}">
    <!-- S-01 Login. Reference: design-reference/screens/01-login.png and the effective body.auth-mode rules of styles.css (INVENTORY-v7).
         Two panels: visual (1fr) | form (0.94fr, min 460), page max 1560. Heights <= 740 px follow @media(max-height:740px). -->
    <UserControl.Resources>
        <conv:ShortHeightConverter x:Key="IsShortHeight" />

        <!-- Short-window variants. Each style reads the UserControl height, because StaticResource cannot switch at runtime. -->
        <Style x:Key="Border.VisualPad" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Padding.AuthVisual}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="Padding" Value="{StaticResource Padding.AuthVisualShort}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.BrandVisual" TargetType="TextBlock" BasedOn="{StaticResource Text.Brand}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="FontSize" Value="17" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.VisualHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.AuthVisualHeading}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="LineHeight" Value="25" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.VisualBody" TargetType="TextBlock" BasedOn="{StaticResource Text.Auth.VisualBody}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="18" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Border.FormPad" TargetType="Border">
            <Setter Property="Padding" Value="{StaticResource Padding.AuthForm}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="Padding" Value="{StaticResource Padding.AuthFormShort}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Grid.FormBrand" TargetType="Grid">
            <Setter Property="Margin" Value="{StaticResource Margin.AuthFormBrand}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource Margin.AuthFormBrandShort}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.Desc" TargetType="TextBlock" BasedOn="{StaticResource Text.AuthDesc}">
            <Setter Property="Margin" Value="{StaticResource Margin.AuthDesc}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource Margin.AuthDescShort}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StackPanel.Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="{StaticResource Margin.AuthField}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="Margin" Value="{StaticResource Margin.AuthFieldShort}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Inputs: 44 high (36 when short). Disabled while the request runs (UI-UX-Flow-Frontend S-01, state Busy). -->
        <Style x:Key="TextBox.Login" TargetType="TextBox" BasedOn="{StaticResource TextBox.Auth}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="MinHeight" Value="{StaticResource Height.InputAuthShort}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Shared password column (D-16): disabled while busy; 36 high on short windows. Hides the password on submit (ConcealWhen). -->
        <Style x:Key="PasswordInput.Login" TargetType="ctl:PasswordInput" BasedOn="{StaticResource {x:Type ctl:PasswordInput}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="MinHeight" Value="{StaticResource Height.InputAuthShort}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.PlaceholderIdentifier" TargetType="TextBlock" BasedOn="{StaticResource Text.Auth.Placeholder}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=IdentifierBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Border.LoginError" TargetType="Border" BasedOn="{StaticResource Border.AuthError}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Button.LoginSubmit" TargetType="Button" BasedOn="{StaticResource Button.AuthSubmit}">
            <Setter Property="Content" Value="{DynamicResource Login.Submit}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IsShortHeight}}" Value="True">
                    <Setter Property="MinHeight" Value="{StaticResource Height.ButtonAuthShort}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Content" Value="{DynamicResource Login.Busy}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Stretch + MaxWidth: fills the window up to 1560 DIP and is centred beyond that. (Center alignment would shrink the grid to its content.) -->
    <Grid x:Name="PageRoot" MaxWidth="{StaticResource MaxWidth.AuthPage}" HorizontalAlignment="Stretch" Background="{StaticResource Bg.AuthFormPanel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="0.94*" MinWidth="{StaticResource MinWidth.AuthForm}" />
        </Grid.ColumnDefinitions>

        <!-- ===== Visual panel (.auth-visual) ===== -->
        <Border Grid.Column="0" Background="{StaticResource Bg.AuthVisual}" ClipToBounds="True">
            <Grid>
                <!-- Base glow (.auth-visual::after) -->
                <Grid IsHitTestVisible="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="74*" />
                        <RowDefinition Height="26*" />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Row="1" Fill="{StaticResource Bg.AuthGlow}" />
                </Grid>

                <Border Style="{StaticResource Border.VisualPad}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- .auth-visual-top: brand left, tagline right -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <ctl:IconView Data="{DynamicResource Icon.Leaf}" Foreground="{StaticResource Brand.Primary}"
                                              Width="{StaticResource Size.BrandIcon}" Height="{StaticResource Size.BrandIcon}" />
                                <TextBlock Style="{StaticResource Text.BrandVisual}" Text="{DynamicResource Brand.Name}"
                                           Margin="{StaticResource Margin.BrandText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Auth.Tagline}" Text="{DynamicResource Auth.Tagline}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>

                        <!-- .auth-art-stage: halo (min(76%,420), round) behind the island (min(100%,560) wide, max 570 high) -->
                        <Grid Grid.Row="1" Margin="0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12*" />
                                <ColumnDefinition Width="76*" />
                                <ColumnDefinition Width="12*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="1" Stretch="Uniform" MaxWidth="{StaticResource MaxWidth.AuthHalo}"
                                     MaxHeight="{StaticResource MaxWidth.AuthHalo}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse Width="100" Height="100" Fill="{StaticResource Bg.AuthHalo}" />
                            </Viewbox>
                            <Image Grid.ColumnSpan="3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   MaxWidth="{StaticResource MaxWidth.AuthArt}" MaxHeight="{StaticResource MaxHeight.AuthArt}"
                                   Effect="{StaticResource Effect.AuthArt}" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{DynamicResource Auth.ArtAlt}">
                                <Image.Source>
                                    <BitmapImage UriSource="pack://application:,,,/EcoQuest;component/Resources/Images/floating_garden_island_waterfall.png" CacheOption="OnLoad" />
                                </Image.Source>
                            </Image>
                        </Grid>

                        <!-- .auth-copy (no card, transparent) -->
                        <StackPanel Grid.Row="2" MaxWidth="{StaticResource MaxWidth.AuthCopy}" HorizontalAlignment="Left">
                            <TextBlock Style="{StaticResource Text.Auth.Kicker}" Text="{DynamicResource Auth.VisualKicker}" />
                            <TextBlock Style="{StaticResource Text.VisualHeading}" Text="{DynamicResource Login.VisualHeading}" />
                            <TextBlock Style="{StaticResource Text.VisualBody}" Text="{DynamicResource Login.VisualBody}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Form panel (.auth-form-panel): scrolls on short windows, card centred when there is room ===== -->
        <ScrollViewer x:Name="FormScroll" Grid.Column="1" Focusable="False" FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource Bg.AuthFormPanel}">
            <Border MinHeight="{Binding ViewportHeight, ElementName=FormScroll}" Style="{StaticResource Border.FormPad}">
                <StackPanel x:Name="FormCard" MaxWidth="{StaticResource Width.AuthCard}" VerticalAlignment="Center">

                    <!-- .auth-form-brand -->
                    <Grid Style="{StaticResource Grid.FormBrand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <ctl:IconView Data="{DynamicResource Icon.Leaf}" Foreground="{StaticResource Brand.Primary}"
                                          Width="{StaticResource Size.BrandIcon}" Height="{StaticResource Size.BrandIcon}" />
                            <TextBlock Style="{StaticResource Text.Brand}" Text="{DynamicResource Brand.Name}"
                                       Margin="{StaticResource Margin.BrandText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Auth.Welcome}" Text="{DynamicResource Login.Welcome}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Style="{StaticResource Text.AuthTitle}" Text="{DynamicResource Login.Title}"
                               LineHeight="35" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Text.Desc}" Text="{DynamicResource Login.Subtitle}" />

                    <!-- Identifier -->
                    <StackPanel Style="{StaticResource StackPanel.Field}">
                        <TextBlock x:Name="IdentifierLabel" Style="{StaticResource Text.AuthLabel}" Text="{DynamicResource Login.IdentifierLabel}" />
                        <Grid>
                            <TextBox x:Name="IdentifierBox" Style="{StaticResource TextBox.Login}"
                                     Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=IdentifierLabel}"
                                     AutomationProperties.Name="{DynamicResource Login.IdentifierLabel}" />
                            <TextBlock Style="{StaticResource Text.PlaceholderIdentifier}" Text="{DynamicResource Login.IdentifierPlaceholder}" />
                        </Grid>
                    </StackPanel>

                    <!-- Password -->
                    <StackPanel Style="{StaticResource StackPanel.Field}">
                        <TextBlock x:Name="PasswordLabel" Style="{StaticResource Text.AuthLabel}" Text="{DynamicResource Login.PasswordLabel}" />
                        <ctl:PasswordInput x:Name="PasswordInput" Style="{StaticResource PasswordInput.Login}"
                                           Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="{DynamicResource Login.PasswordPlaceholder}"
                                           ConcealWhen="{Binding IsBusy}"
                                           FocusRequest="{Binding PasswordFocusRequest}"
                                           AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                                           AutomationProperties.Name="{DynamicResource Login.PasswordLabel}" />                    </StackPanel>

                    <!-- .auth-error -->
                    <Border Style="{StaticResource Border.LoginError}">
                        <TextBlock Style="{StaticResource Text.Base}" Foreground="{StaticResource State.ErrorText}"
                                   Text="{Binding ErrorMessage}" AutomationProperties.LiveSetting="Assertive" />
                    </Border>

                    <Button Style="{StaticResource Button.LoginSubmit}" Command="{Binding LoginCommand}" IsDefault="True" />

                    <!-- .alt -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource Margin.AuthAlt}">
                        <TextBlock Style="{StaticResource Text.Base}" FontSize="13" Foreground="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" Text="{DynamicResource Login.NoAccount}" />
                        <Button Style="{StaticResource Button.AuthLink}" Command="{Binding GoToRegisterCommand}"
                                Content="{DynamicResource Login.CreateAccount}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>

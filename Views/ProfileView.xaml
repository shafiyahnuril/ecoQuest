<UserControl x:Class="EcoQuest.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             xmlns:conv="clr-namespace:EcoQuest.Converters"
             mc:Ignorable="d" IsTabStop="False" FocusVisualStyle="{x:Null}"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}">
    <!-- S-10 Profil. Reference: design-reference/screens/12-profile.png, styles.css .profile-layout .profile-avatar .field .input .btn.
         Deltas: username and email are read-only (SRS FR-1.4; the prototype shows editable boxes); "Ganti foto"/"Hapus" and the photo error are
         derived (UIR-24); the prototype's "Perubahan password memerlukan backend..." note is dropped (UI-UX-Flow-Frontend 4.0). -->
    <UserControl.Resources>
        <conv:LocalImageConverter x:Key="LocalImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="TextBox.ReadOnly" TargetType="TextBox" BasedOn="{StaticResource TextBox.Default}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="{StaticResource Bg.App}" />
            <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        </Style>
        <Style x:Key="PasswordInput.Profile" TargetType="ctl:PasswordInput" BasedOn="{StaticResource {x:Type ctl:PasswordInput}}">
            <Setter Property="IsCompact" Value="True" />
            <Setter Property="MinHeight" Value="{StaticResource Height.Input}" />
        </Style>
        <Style x:Key="Button.GhostSmall" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="{StaticResource Height.ButtonSmall}" />
            <Setter Property="Padding" Value="{StaticResource Padding.ButtonSmall}" />
        </Style>
        <Style x:Key="Text.ProfileName" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.ProfileMessage" TargetType="TextBlock" BasedOn="{StaticResource Text.FieldError}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ErrorBanner.Profile" TargetType="ctl:ErrorBanner">
            <Setter Property="Margin" Value="{StaticResource Margin.ProfileBanner}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="{StaticResource Margin.PageHead}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Header}" Margin="{StaticResource Margin.PageHeadTitle}" TextWrapping="NoWrap"
                           Text="{DynamicResource Profile.Title}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.BodyRelaxed}" Text="{DynamicResource Profile.Subtitle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Margin="15,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Top"
                       Text="{Binding TodayText}" />
        </Grid>

        <ctl:StateHost State="{Binding State}" IsEmpty="{Binding IsEmpty}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
            <ctl:StateHost.LoadingContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="{StaticResource Width.ProfileGap}" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Border.Skeleton}" Height="{StaticResource Height.SkeletonProfileCard}" CornerRadius="{StaticResource Radius.Card}" />
                    <Border Grid.Column="2" Style="{StaticResource Border.Skeleton}" Height="{StaticResource Height.SkeletonProfileCard}" CornerRadius="{StaticResource Radius.Card}" />
                </Grid>
            </ctl:StateHost.LoadingContent>

            <ctl:StateHost.Content>
                <StackPanel>
                    <ctl:ErrorBanner Style="{StaticResource ErrorBanner.Profile}" Message="{Binding ErrorMessage}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="{StaticResource Width.ProfileGap}" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AccountCard" Style="{StaticResource Border.Card}">
                            <Border.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SaveProfileCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Title}" Margin="{StaticResource Margin.ProfileCardTitle}"
                                           Text="{DynamicResource Profile.Account}" AutomationProperties.HeadingLevel="Level2" />

                                <Grid Margin="{StaticResource Margin.ProfileAvatarRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="AvatarCircle" Width="{StaticResource Size.AvatarProfile}" Height="{StaticResource Size.AvatarProfile}"
                                          VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Profile.Avatar}">
                                        <Ellipse Fill="{StaticResource Avatar.ProfileBg}" />
                                        <TextBlock Style="{StaticResource Text.Base}" FontFamily="{StaticResource Font.Regular}"
                                                   FontSize="{StaticResource FontSize.AvatarProfile}" Foreground="{StaticResource Brand.Primary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding AvatarInitial}"
                                                   AutomationProperties.Name="" AutomationProperties.IsOffscreenBehavior="Offscreen" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding AvatarImagePath, Converter={StaticResource LocalImage}, ConverterParameter=192}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="{StaticResource Margin.ProfileAvatarText}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Text.ProfileName}" Text="{Binding UserName}" />
                                        <TextBlock Style="{StaticResource Text.Small}" TextTrimming="CharacterEllipsis" Text="{Binding Email}" />
                                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.ProfileAvatarActions}">
                                            <Button x:Name="ChangePhotoButton" Style="{StaticResource Button.Small}" Command="{Binding PickAvatarCommand}"
                                                    Content="{DynamicResource Profile.ChangePhoto}"
                                                    AutomationProperties.Name="{DynamicResource Profile.ChangePhotoName}" />
                                            <Button x:Name="RemovePhotoButton" Style="{StaticResource Button.GhostSmall}" Margin="{StaticResource Margin.ProfileButtonGap}"
                                                    Command="{Binding RemoveAvatarCommand}" Content="{DynamicResource Profile.RemovePhoto}"
                                                    AutomationProperties.Name="{DynamicResource Profile.RemovePhotoName}"
                                                    Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <TextBlock x:Name="AvatarMessage" Style="{StaticResource Text.ProfileMessage}" Text="{Binding AvatarError}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="UserNameLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Register.UsernameLabel}" />
                                    <TextBox x:Name="UserNameBox" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding UserName, Mode=OneWay}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=UserNameLabel}" />
                                </StackPanel>
                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="EmailLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Register.EmailLabel}" />
                                    <TextBox x:Name="EmailBox" Style="{StaticResource TextBox.ReadOnly}" Text="{Binding Email, Mode=OneWay}"
                                             AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" />
                                </StackPanel>
                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="CityLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Register.CityLabel}" />
                                    <ComboBox x:Name="CityBox" Style="{StaticResource ComboBox.Default}" ItemsSource="{Binding Cities}"
                                              SelectedItem="{Binding City, Mode=TwoWay}"
                                              AutomationProperties.LabeledBy="{Binding ElementName=CityLabel}" />
                                    <TextBlock x:Name="CityMessage" Style="{StaticResource Text.ProfileMessage}" Text="{Binding CityError}" />
                                </StackPanel>

                                <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left"
                                        Command="{Binding SaveProfileCommand}" Content="{DynamicResource Profile.SaveCity}" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SecurityCard" Grid.Column="2" Style="{StaticResource Border.Card}">
                            <Border.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ChangePasswordCommand}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Title}" Margin="{StaticResource Margin.ProfileCardTitle}"
                                           Text="{DynamicResource Profile.Security}" AutomationProperties.HeadingLevel="Level2" />

                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="OldPasswordLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Profile.OldPassword}" />
                                    <ctl:PasswordInput x:Name="OldPasswordField" Style="{StaticResource PasswordInput.Profile}"
                                                       Password="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       ConcealWhen="{Binding IsBusy}"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=OldPasswordLabel}"
                                                       AutomationProperties.Name="{DynamicResource Profile.OldPassword}" />
                                    <TextBlock x:Name="OldPasswordMessage" Style="{StaticResource Text.ProfileMessage}" Text="{Binding OldPasswordError}" />
                                </StackPanel>
                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="NewPasswordLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Profile.NewPassword}" />
                                    <ctl:PasswordInput x:Name="NewPasswordField" Style="{StaticResource PasswordInput.Profile}"
                                                       Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       ConcealWhen="{Binding IsBusy}"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=NewPasswordLabel}"
                                                       AutomationProperties.Name="{DynamicResource Profile.NewPassword}" />
                                    <TextBlock x:Name="NewPasswordMessage" Style="{StaticResource Text.ProfileMessage}" Text="{Binding NewPasswordError}" />
                                </StackPanel>
                                <StackPanel Margin="{StaticResource Margin.ProfileField}">
                                    <TextBlock x:Name="ConfirmPasswordLabel" Style="{StaticResource Text.Label}" Margin="{StaticResource Margin.ProfileLabel}"
                                               Text="{DynamicResource Profile.ConfirmNewPassword}" />
                                    <ctl:PasswordInput x:Name="ConfirmPasswordField" Style="{StaticResource PasswordInput.Profile}"
                                                       Password="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       ConcealWhen="{Binding IsBusy}"
                                                       AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPasswordLabel}"
                                                       AutomationProperties.Name="{DynamicResource Profile.ConfirmNewPassword}" />
                                    <TextBlock x:Name="ConfirmPasswordMessage" Style="{StaticResource Text.ProfileMessage}" Text="{Binding ConfirmNewPasswordError}" />
                                </StackPanel>

                                <Button x:Name="ChangePasswordButton" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                                        Command="{Binding ChangePasswordCommand}" Content="{DynamicResource Profile.ChangePassword}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ctl:StateHost.Content>
        </ctl:StateHost>
    </StackPanel>
</UserControl>

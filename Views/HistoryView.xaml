<UserControl x:Class="EcoQuest.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EcoQuest.ViewModels"
             xmlns:items="clr-namespace:EcoQuest.ViewModels.Items"
             xmlns:ctl="clr-namespace:EcoQuest.Controls"
             xmlns:conv="clr-namespace:EcoQuest.Converters"
             mc:Ignorable="d" IsTabStop="False" FocusVisualStyle="{x:Null}"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}">
    <!-- S-07 Riwayat. Reference: design-reference/screens/09-history.png, INVENTORY-v7 .history-layout .history-day .history-line .history-detail .filters .chip.
         Deltas: D-09 (sentence case), D-12 (long activity description in the info tooltip), UIR-61 (Dari/Sampai pickers + range error),
         UIR-60 (quantity, points, note/photo icons per line), UIR-62 (formula snapshot and photo/placeholder in the detail panel).
         The list and the detail panel are capped to the visible page height (ViewportFill) so the list scrolls inside itself and virtualizes. -->
    <UserControl.Resources>
        <conv:ResourceKeyConverter x:Key="ResourceKey" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime" />
        <conv:LocalImageConverter x:Key="LocalImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="Text.HistoryName" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontFamily" Value="{StaticResource Font.Bold}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.HistoryLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Text.HistoryAmount" TargetType="TextBlock" BasedOn="{StaticResource Text.HistoryLine}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Text.HistoryMeta" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="Text.HistoryDetailTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.HistoryName}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="{StaticResource Height.HistoryDetailTitleLine}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style x:Key="Text.HistoryDetailFormula" TargetType="TextBlock" BasedOn="{StaticResource Text.Tiny}">
            <Setter Property="LineHeight" Value="{StaticResource Height.HistoryDetailFormulaLine}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style x:Key="Text.HistoryNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        </Style>
        <Style x:Key="Text.HistoryNoActivity" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Margin" Value="{StaticResource Margin.HistoryNoActivity}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLines}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Text.HistoryPhotoMissing" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Padding" Value="{StaticResource Padding.HistoryPhotoMissing}" />
            <Setter Property="Background" Value="{StaticResource Bg.Mint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source, ElementName=Photo}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Border.HistoryDetail" TargetType="Border" BasedOn="{StaticResource Border.Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Panel.NoFocus" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>


        <Style x:Key="ListBox.History" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="0" CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListBoxItem.HistoryDay" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{StaticResource Margin.HistoryDay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <EventSetter Event="KeyDown" Handler="OnDayKeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Line.Subtle}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.HistoryDay}" Padding="{StaticResource Padding.HistoryDay}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource History.DayHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource History.DayHoverLine}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource History.DayHoverBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource History.DayHoverLine}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Border.Block" TargetType="Border" BasedOn="{StaticResource Border.Skeleton}" />

        <DataTemplate x:Key="HistoryLine" DataType="{x:Type items:HistoryLineItemViewModel}">
            <Grid Margin="{StaticResource Margin.HistoryLine}" MinHeight="{StaticResource MinHeight.HistoryLine}" ToolTipService.InitialShowDelay="300">
                <Grid.ToolTip>
                    <ToolTip Style="{StaticResource ToolTip.Default}">
                        <TextBlock Text="{Binding FormulaText}" />
                    </ToolTip>
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ctl:IconView Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Foreground="{StaticResource Text.Primary}"
                              Width="{StaticResource Size.IconHistoryLine}" Height="{StaticResource Size.IconHistoryLine}" VerticalAlignment="Center"
                              AutomationProperties.IsOffscreenBehavior="Offscreen" />
                <TextBlock Grid.Column="1" Style="{StaticResource Text.HistoryLine}" Margin="{StaticResource Margin.HistoryLineName}"
                           VerticalAlignment="Center" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.HistoryMeta}" Margin="{StaticResource Margin.HistoryLineGap}"
                           Width="{StaticResource Width.HistoryQuantity}" VerticalAlignment="Center" Text="{Binding QuantityText}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="{StaticResource Margin.HistoryLineGap}"
                            Width="{StaticResource Width.HistoryExtras}" VerticalAlignment="Center">
                    <ctl:IconView Data="{DynamicResource Icon.Note}" Foreground="{StaticResource Text.Secondary}"
                                  Width="{StaticResource Size.IconHistoryExtra}" Height="{StaticResource Size.IconHistoryExtra}"
                                  Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.IsOffscreenBehavior="Offscreen" />
                    <ctl:IconView Data="{DynamicResource Icon.Camera}" Foreground="{StaticResource Text.Secondary}"
                                  Width="{StaticResource Size.IconHistoryExtra}" Height="{StaticResource Size.IconHistoryExtra}"
                                  Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.IsOffscreenBehavior="Offscreen" />
                </StackPanel>
                <TextBlock Grid.Column="4" Style="{StaticResource Text.HistoryAmount}" Margin="{StaticResource Margin.HistoryLineGap}"
                           Width="{StaticResource Width.HistoryCo2}" VerticalAlignment="Center" Text="{Binding Co2Text}" />
                <TextBlock Grid.Column="5" Style="{StaticResource Text.HistoryMeta}" Margin="{StaticResource Margin.HistoryLineGap}"
                           Width="{StaticResource Width.HistoryPoints}" VerticalAlignment="Center" Text="{Binding PointsText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryDay" DataType="{x:Type items:HistoryDayItemViewModel}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.HistoryName}" Text="{Binding DateText}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Impact}" TextWrapping="NoWrap" Margin="{StaticResource Margin.HistoryLineGap}"
                               Typography.NumeralAlignment="Tabular" Text="{Binding TotalText}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.HistoryMeta}" Margin="{StaticResource Margin.HistoryLineGap}"
                               Width="{StaticResource Width.HistoryPoints}" VerticalAlignment="Center" Text="{Binding PointsText}" />
                </Grid>
                <ItemsControl Style="{StaticResource Panel.NoFocus}" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource HistoryLine}" />
                <TextBlock Style="{StaticResource Text.HistoryNoActivity}" Text="{Binding EmptyText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="HistoryDetailItem" DataType="{x:Type items:HistoryLineItemViewModel}">
            <Border BorderBrush="{StaticResource Line.Subtle}" BorderThickness="0,1,0,0" Padding="{StaticResource Padding.HistoryDetailItem}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.HistoryDetailTitle}" Text="{Binding Name}" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="{StaticResource Size.HistoryInfoHit}"
                                Height="{StaticResource Size.HistoryInfoHit}" Margin="{StaticResource Margin.HistoryInfoHit}"
                                VerticalAlignment="Top" ToolTipService.InitialShowDelay="300"
                                Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.Name="{DynamicResource History.ActivityInfo}">
                            <Button.ToolTip>
                                <ToolTip Style="{StaticResource ToolTip.Default}">
                                    <TextBlock Text="{Binding Description}" />
                                </ToolTip>
                            </Button.ToolTip>
                            <ctl:IconView Data="{DynamicResource Icon.Info}" Foreground="{StaticResource Brand.Forest}"
                                          Width="{StaticResource Size.IconInfo}" Height="{StaticResource Size.IconInfo}"
                                          AutomationProperties.IsOffscreenBehavior="Offscreen" />
                        </Button>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Small}" Margin="{StaticResource Margin.HistoryDetailQuantity}" Text="{Binding QuantityText}" />
                    <TextBlock Style="{StaticResource Text.Impact}" TextWrapping="NoWrap" Margin="{StaticResource Margin.HistoryDetailImpact}" Text="{Binding DetailCo2Text}" />
                    <TextBlock Style="{StaticResource Text.HistoryDetailFormula}" Margin="{StaticResource Margin.HistoryDetailFormula}" Text="{Binding FormulaText}" />
                    <TextBlock Style="{StaticResource Text.HistoryNote}" Margin="{StaticResource Margin.HistoryDetailNote}" Text="{Binding Note}"
                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                    <Border Width="{StaticResource Width.HistoryPhoto}" HorizontalAlignment="Left" Margin="{StaticResource Margin.HistoryPhoto}"
                            CornerRadius="{StaticResource Radius.HistoryPhoto}" ClipToBounds="True"
                            Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <TextBlock Style="{StaticResource Text.HistoryPhotoMissing}" Text="{DynamicResource Photo.Missing}" />
                            <Image x:Name="Photo" Stretch="UniformToFill" AutomationProperties.Name="{DynamicResource History.PhotoAlt}"
                                   Source="{Binding PhotoFilePath, Converter={StaticResource LocalImage}, ConverterParameter=360}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="{StaticResource Margin.PageHead}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Header}" Margin="{StaticResource Margin.PageHeadTitle}" TextWrapping="NoWrap"
                           Text="{DynamicResource History.Title}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource Text.BodyRelaxed}" Text="{DynamicResource History.Subtitle}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Small}" Margin="15,0,0,0" TextWrapping="NoWrap" VerticalAlignment="Top"
                       Text="{Binding TodayText}" />
        </Grid>

        <Border Style="{StaticResource Border.Card}" Margin="{StaticResource Margin.HistoryFilterCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource History.PeriodGroup}">
                        <RadioButton Style="{StaticResource RadioButton.Segmented}" GroupName="HistoryPeriod" Margin="{StaticResource Margin.FilterChip}"
                                     Content="{DynamicResource History.Period.Week}"
                                     IsChecked="{Binding Period, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Week}"
                                     Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.Week}" />
                        <RadioButton Style="{StaticResource RadioButton.Segmented}" GroupName="HistoryPeriod" Margin="{StaticResource Margin.FilterChip}"
                                     Content="{DynamicResource History.Period.Month}"
                                     IsChecked="{Binding Period, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Month}"
                                     Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.Month}" />
                        <RadioButton Style="{StaticResource RadioButton.Segmented}" GroupName="HistoryPeriod" Margin="{StaticResource Margin.FilterChip}"
                                     Content="{DynamicResource History.Period.All}"
                                     IsChecked="{Binding Period, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                                     Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:HistoryPeriod.All}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Margin.HistoryDates}">
                        <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap" VerticalAlignment="Center"
                                   Margin="{StaticResource Margin.HistoryDateLabel}" Text="{DynamicResource History.From}" />
                        <DatePicker Style="{StaticResource DatePicker.Default}" Width="{StaticResource Width.HistoryDate}" xml:lang="id-ID"
                                    AutomationProperties.Name="{DynamicResource History.From}" ctl:InputState.IsInvalid="{Binding HasRangeError}"
                                    SelectedDate="{Binding From, Converter={StaticResource DateOnlyToDateTime}, ValidatesOnNotifyDataErrors=False}" />
                        <TextBlock Style="{StaticResource Text.Small}" TextWrapping="NoWrap" VerticalAlignment="Center"
                                   Margin="{StaticResource Margin.HistoryDateGap}" Text="{DynamicResource History.To}" />
                        <DatePicker Style="{StaticResource DatePicker.Default}" Width="{StaticResource Width.HistoryDate}" xml:lang="id-ID"
                                    AutomationProperties.Name="{DynamicResource History.To}" ctl:InputState.IsInvalid="{Binding HasRangeError}"
                                    SelectedDate="{Binding To, Converter={StaticResource DateOnlyToDateTime}, ValidatesOnNotifyDataErrors=False}" />
                    </StackPanel>
                    <!-- TODO(FE-20): "Ekspor CSV" button goes into the right column (Grid.Column=2, HorizontalAlignment=Right). -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.FieldError}" Margin="{StaticResource Margin.HistoryDates}"
                               Text="{Binding RangeError}" AutomationProperties.LiveSetting="Polite"
                               Visibility="{Binding HasRangeError, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource Margin.HistoryFilterRow}"
                            AutomationProperties.Name="{DynamicResource History.CategoryGroup}"
                            Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibility}}">
                    <RadioButton Style="{StaticResource RadioButton.Segmented}" GroupName="HistoryCategoryAll" Margin="{StaticResource Margin.FilterChip}"
                                 Content="{DynamicResource History.Category.All}"
                                 IsChecked="{Binding AllCategoriesSelected, Mode=OneWay}" Command="{Binding SelectAllCategoriesCommand}" />
                    <ItemsControl Style="{StaticResource Panel.NoFocus}" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type items:HistoryCategoryChip}">
                                <ToggleButton Style="{StaticResource ToggleButton.Chip}" Margin="{StaticResource Margin.FilterChip}"
                                              Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <ctl:StateHost State="{Binding State}" IsEmpty="{Binding IsEmpty}" ErrorMessage="{Binding ErrorMessage}" RetryCommand="{Binding LoadCommand}">
            <ctl:StateHost.LoadingContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource Width.HistoryGap}" />
                        <ColumnDefinition Width="{StaticResource Column.HistoryDetail}" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{StaticResource Border.Block}" Height="{StaticResource Height.SkeletonHistoryDay}"
                                CornerRadius="{StaticResource Radius.HistoryDay}" Margin="{StaticResource Margin.HistoryDay}" />
                        <Border Style="{StaticResource Border.Block}" Height="{StaticResource Height.SkeletonHistoryDay}"
                                CornerRadius="{StaticResource Radius.HistoryDay}" Margin="{StaticResource Margin.HistoryDay}" />
                        <Border Style="{StaticResource Border.Block}" Height="{StaticResource Height.SkeletonHistoryDay}"
                                CornerRadius="{StaticResource Radius.HistoryDay}" Margin="{StaticResource Margin.HistoryDay}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Border.Block}" VerticalAlignment="Top"
                            Height="{StaticResource MinHeight.HistoryList}" CornerRadius="{StaticResource Radius.Card}" />
                </Grid>
            </ctl:StateHost.LoadingContent>

            <ctl:StateHost.EmptyContent>
                <Border Style="{StaticResource Border.Card}" Padding="0">
                    <ctl:EmptyState ImageSource="{StaticResource Image.EmptySprout}" ImageWidth="160" Title="{DynamicResource History.Empty}"
                                    ActionText="{DynamicResource History.EmptyCta}" ActionCommand="{Binding GoToReviewCommand}" />
                </Border>
            </ctl:StateHost.EmptyContent>

            <ctl:StateHost.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource Width.HistoryGap}" />
                        <ColumnDefinition Width="{StaticResource Column.HistoryDetail}" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="DayList" Style="{StaticResource ListBox.History}" VerticalAlignment="Top"
                             MinHeight="{StaticResource MinHeight.HistoryList}" ctl:ViewportFill.Pin="True"
                             ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                             ItemTemplate="{StaticResource HistoryDay}" ItemContainerStyle="{StaticResource ListBoxItem.HistoryDay}" />

                    <Border Grid.Column="2" Style="{StaticResource Border.HistoryDetail}" VerticalAlignment="Top"
                            MinHeight="{StaticResource MinHeight.HistoryList}" ctl:ViewportFill.Pin="True" DataContext="{Binding SelectedDay}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Title}" Margin="{StaticResource Margin.HistoryDetailTitle}"
                                           Text="{DynamicResource History.DetailTitle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding DateText}" />
                                <TextBlock Style="{StaticResource Text.Header}" Foreground="{StaticResource Brand.Forest}" TextWrapping="Wrap"
                                           Margin="{StaticResource Margin.HistoryDetailTotal}" Text="{Binding TotalText}" />
                                <TextBlock Style="{StaticResource Text.Body}" Margin="{StaticResource Margin.HistoryDetailPoints}" Text="{Binding PointsText}" />
                                <ItemsControl Style="{StaticResource Panel.NoFocus}" ItemsSource="{Binding Lines}"
                                              ItemTemplate="{StaticResource HistoryDetailItem}" />
                                <TextBlock Style="{StaticResource Text.Tiny}" Margin="{StaticResource Margin.SummaryDisclaimer}"
                                           Text="{DynamicResource Points.Disclaimer}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </ctl:StateHost.Content>
        </ctl:StateHost>
    </StackPanel>
</UserControl>
